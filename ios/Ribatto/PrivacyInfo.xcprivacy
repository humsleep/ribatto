<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The video and its audio never leave the device: every frame and every
	     sample is analysed here, and there is no account and no analytics SDK.
	     What does leave is what the ads send, and that is Google AdMob's doing
	     (Store/AdsManager.swift), not this app's own code. The app's code makes
	     one other call, CLGeocoder in PlaceLookup, which sends a video's GPS
	     coordinate to Apple to name the court; that is not tracking.

	     The rule Apple's upload check enforces (ITMS-91064): with no
	     NSPrivacyTrackingDomains, NOTHING in this file may say tracking — not
	     the top-level NSPrivacyTracking and not any per-type
	     NSPrivacyCollectedDataTypeTracking. Three builds were refused on
	     2026-09-30: 11 (true + empty domain array), 12 (true, no domain key)
	     and 13 (false, but Device ID / Advertising Data marked tracking).
	     FC Scope on the same account ships AdMob with exactly this shape.

	     Listing Google's ad domains instead is not an option: requests to
	     listed domains are blocked when the user declines ATT, which would also
	     stop the non-personalised ads and the rewarded ad that opens the pass.

	     Device ID and Advertising Data are therefore not listed here. They are
	     the ad SDK's collection, and GoogleMobileAds.framework's own manifest
	     declares them (Device ID as tracking). Apple's privacy report merges
	     every manifest in the bundle, so nothing is hidden. The App Store
	     Connect answers still say "used to track" for both (APP_STORE.md §5):
	     that label covers the whole app including the SDK, and the ATT prompt
	     stays.
	     Keep this in step with Views/PrivacyView.swift and docs/privacy.html. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- The rest of what the AdMob SDK collects, per Google's App Store data
	     disclosure guidance, none of it tracking (see above for the two that
	     are). None of it is linked to the user by this app (there is no
	     account to link it to). The App Privacy answers in App Store Connect
	     are a superset — "Data Not Collected" is no longer true. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCoarseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!-- Two required-reason APIs, both on the app's own files and settings.

	     UserDefaults backs @AppStorage (language, onboarding flag) and
	     ProPass's end time — all of it this app's own
	     data, never shared with or read from another app or a device-wide
	     identifier.

	     File timestamps: PosterCache.key(for:) reads a clip's modification
	     date to key its thumbnail cache, so a re-rendered clip whose poster is
	     rewritten in place still refreshes, and SessionStore reads a rendered
	     clip's byte size. Both files live in this app's own container, which
	     is what C617.1 covers. Undeclared, this is the App Store's automated
	     "ITMS-91053: Missing API declaration" mail — add the category here
	     whenever a new call reads file metadata. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
