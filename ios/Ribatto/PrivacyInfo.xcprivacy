<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ribatto does not track. Every frame and every sample is analysed on
	     the device: the video and its audio are never uploaded, there is no
	     analytics SDK, no advertising, and no account.
	     The app does make two network calls, neither of which is tracking and
	     neither of which reaches a server of ours: StoreKit for the one-time
	     purchase, and CLGeocoder in PlaceLookup, which sends a video's own GPS
	     coordinate to Apple once to name the court. Keep this in step with the
	     in-app Privacy screen (Views/PrivacyView.swift). -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Nothing leaves the device, so nothing is "collected" in Apple's
	     sense. Photos access reads the video in place and writes clips back;
	     that is not collection. This must stay in step with the App Privacy
	     answers in App Store Connect ("Data Not Collected"). -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- Two required-reason APIs, both on the app's own files and settings.

	     UserDefaults backs @AppStorage (language, onboarding flag) and
	     PurchaseManager's entitlement counters — all of it this app's own
	     data, never shared with or read from another app or a device-wide
	     identifier.

	     File timestamps: PosterCache.key(for:) reads a clip's modification
	     date to key its thumbnail cache, so a re-rendered clip whose poster is
	     rewritten in place still refreshes, and SessionStore reads a rendered
	     clip's byte size. Both files live in this app's own container, which
	     is what C617.1 covers. Undeclared, this is the App Store's automated
	     "ITMS-91053: Missing API declaration" mail — add the category here
	     whenever a new call reads file metadata. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
