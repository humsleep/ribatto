<dict>
	<!-- The nine in-app languages, declared for the App Store product page.

	     This file exists only for this key. Everything else in the bundle's
	     Info.plist is still generated (GENERATE_INFOPLIST_FILE = YES) and
	     merged into it at build time, so add new keys as INFOPLIST_KEY_*
	     build settings first and only fall back here when Xcode drops them.

	     Why it cannot be a build setting: INFOPLIST_KEY_CFBundleLocalizations
	     was set for both configurations and never reached the built plist —
	     the generator only honours the keys it knows, and this is not one of
	     them. Without the declaration the store page lists English alone, and
	     the nine languages the app actually ships are invisible to buyers. -->
	<!-- Queried by `canOpenURL` before the "tell me what you filmed" button is
	     shown on a session that detected nothing. Since iOS 9 a scheme has to be
	     declared here to be queryable, including the system ones — without this
	     the check returns false on a real device too and the button never
	     appears, which is exactly the feedback we would never receive. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>mailto</string>
	</array>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ko</string>
		<string>ja</string>
		<string>es</string>
		<string>pt</string>
		<string>de</string>
		<string>fr</string>
		<string>it</string>
		<string>zh-Hans</string>
	</array>

	<!-- AdMob. The app id comes from the GAD_APPLICATION_ID build setting:
	     Debug carries Google's public test id, Release is empty until the real
	     id from the AdMob console goes in (RELEASE.md 4-2). AdsManager refuses
	     to start the SDK on an empty or malformed id, so a Release build with
	     the setting unfilled ships without ads rather than crashing at launch.
	     SKAdNetworkItems is Google's published list for attribution; refresh it
	     from developers.google.com/admob/ios/quick-start when the SDK is bumped. -->
	<key>GADApplicationIdentifier</key>
	<string>$(GAD_APPLICATION_ID)</string>
